<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Your SyncBoard email is verified</title>
</head>
<body style="margin:0;padding:0;background-color:#eef1f6;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">
  <!-- Preheader (inbox preview text) -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
    Your email address has been verified — your SyncBoard account is fully activated.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef1f6;">
    <tr>
      <td align="center" style="padding:40px 16px;">

        <!-- Brand -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
          <tr>
            <td align="left" style="padding-bottom:24px;">
              <span style="display:inline-block;width:28px;height:28px;line-height:28px;text-align:center;background-color:#4f46e5;color:#ffffff;font-size:15px;font-weight:bold;border-radius:7px;">S</span>
              <span style="vertical-align:middle;margin-left:8px;font-size:17px;font-weight:600;color:#111827;">SyncBoard</span>
            </td>
          </tr>
        </table>

        <!-- Card -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(17,24,39,0.08);">
          <!-- Accent -->
          <tr>
            <td height="5" style="background-color:#22c55e;font-size:0;line-height:0;">&nbsp;</td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:40px 48px;">
              <h1 style="margin:0 0 14px;font-size:23px;line-height:1.3;font-weight:700;color:#111827;">
                Email verified{{#if displayName}}, {{displayName}}{{/if}} ✓
              </h1>

              <p style="margin:0 0 26px;font-size:15px;line-height:1.65;color:#4b5563;">
                Your email address has been confirmed and your SyncBoard account is
                now fully activated. You can create workspaces, invite teammates,
                and collaborate on boards.
              </p>

              <!-- Notice box -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0fdf4;border-left:3px solid #86efac;border-radius:6px;">
                <tr>
                  <td style="padding:14px 18px;font-size:13px;line-height:1.6;color:#4b5563;">
                    Didn't verify your email just now? Someone may have clicked the link
                    from your inbox — we recommend changing your password.
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>

        <!-- Footer -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;">
          <tr>
            <td align="center" style="padding:24px 16px 0;font-size:12px;line-height:1.7;color:#9ca3af;">
              You received this because of activity on your SyncBoard account.<br />
              &copy; 2026 SyncBoard &middot; All rights reserved.
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>