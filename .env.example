# ============================================================
# SYNCBOARD ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env for local development
# ============================================================

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://syncuser:syncpass@localhost:5432/syncboard?schema=public"
DATABASE_REPLICA_URL="postgresql://syncuser:syncpass@localhost:5433/syncboard?schema=public"

# Authentication & Keys
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_PRIVATE_KEY_PATH="keys/private.pem"
JWT_PUBLIC_KEY_PATH="keys/public.pem"

# Redis Cache & Token Blacklist
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Event Bus
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Google OAuth (Optional for local testing)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
