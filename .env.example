# ============================================================
# SYNCBOARD ENVIRONMENT VARIABLES TEMPLATE
# Local dev: cp .env.example .env
# Docker:    values below are overridden by docker-compose.yml
# ============================================================

# ------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS origin(s) allowed to call the API (comma-separated)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL="postgresql://syncuser:syncpass@localhost:5432/syncboard?schema=public"
DATABASE_REPLICA_URL="postgresql://syncuser:syncpass@localhost:5433/syncboard?schema=public"

# ------------------------------------------------------------
# 3. Authentication & JWT Keys
# ------------------------------------------------------------
# RS256 key files (generated automatically by docker/entrypoint.sh in Docker).
# For local dev, generate once: openssl genrsa -out keys/private.pem 2048
#                                openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH="keys/private.pem"
JWT_PUBLIC_KEY_PATH="keys/public.pem"
# HS256 symmetric fallback — only used when key files are absent (dev only)
JWT_SECRET="dev-secret-key-32-chars-long-minimum-for-hs256"

# ------------------------------------------------------------
# 4. Redis Cache & Token Blacklist
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------
# 5. RabbitMQ Event Bus
# ------------------------------------------------------------
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_ENABLE=true
ASYNC_MAIL=false

# ------------------------------------------------------------
# 6. Google OAuth 2.0 (Optional)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------
# 7. Mail (SMTP)
# ------------------------------------------------------------
# Verify: node scripts/smtp-smoke.js recipient@example.com
#
# Provider examples:
#   MailHog (Dev):        host=localhost,          port=1025, secure=false
#   Gmail (App Password): host=smtp.gmail.com,     port=465,  secure=true
#   MailerSend:           host=smtp.mailersend.net, port=587, secure=false
#   Resend:               host=smtp.resend.com,    port=465,  secure=true, user=resend
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SyncBoard <no-reply@syncboard.local>"
MAIL_FROM_NAME=SyncBoard

# ------------------------------------------------------------
# 8. Object Storage (MinIO / AWS S3)
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=syncboard-files
# Local MinIO via Docker Compose (path-style required for MinIO)
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=3600
MAX_FILE_SIZE_BYTES=26214400
