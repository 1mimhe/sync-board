# ============================================================
# SYNCBOARD ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env for local development: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS origin(s) allowed to call the API (comma-separated for multiple)
CLIENT_URL=http://localhost:3001

# ------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL="postgresql://syncuser:syncpass@localhost:5432/syncboard?schema=public"
DATABASE_REPLICA_URL="postgresql://syncuser:syncpass@localhost:5433/syncboard?schema=public"

# ------------------------------------------------------------
# 3. Authentication & JWT Keys
# ------------------------------------------------------------
JWT_PRIVATE_KEY_PATH="keys/private.pem"
JWT_PUBLIC_KEY_PATH="keys/public.pem"
JWT_SECRET="dev-secret-key-32-chars-long-minimum-for-hs256"

# ------------------------------------------------------------
# 4. Redis Cache & Token Blacklist
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------
# 5. RabbitMQ Event Bus (Phase 5)
# ------------------------------------------------------------
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ------------------------------------------------------------
# 6. Google OAuth 2.0 (Optional)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------
# 7. Mail (SMTP)
# ------------------------------------------------------------
# Verify settings: node scripts/smtp-smoke.js recipient@example.com
#
# Common provider settings:
#   MailHog (Dev):        host=localhost, port=1025, secure=false (Web UI: http://localhost:8025)
#   Gmail (App Password): host=smtp.gmail.com, port=465, secure=true
#   MailerSend:           host=smtp.mailersend.net, port=587, secure=false
#   Brevo / SendGrid:     host=smtp-relay.brevo.com (or smtp.sendgrid.net), port=587, secure=false
#   Resend:               host=smtp.resend.com, port=465, secure=true, user=resend
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SyncBoard <no-reply@syncboard.local>"
MAIL_FROM_NAME=SyncBoard
