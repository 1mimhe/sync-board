generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer

  @@map("workspace_role")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked

  @@map("invitation_status")
}

enum ActionType {
  created
  updated
  deleted
  moved
  archived
  unarchived

  @@map("action_type")
}

enum EntityType {
  board
  list
  card
  comment
  label
  assignee
  attachment
  document
  workspace

  @@map("entity_type")
}

enum AttachmentType {
  file
  image
  link

  @@map("attachment_type")
}

enum CardPriority {
  lowest
  low
  medium
  high
  urgent

  @@map("card_priority")
}

enum CardStatus {
  not_started
  active
  done
  closed

  @@map("card_status")
}


enum CardFieldType {
  text
  number
  date
  select
  user

  @@map("card_field_type")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.VarChar(255)
  passwordHash         String?               @map("password_hash") @db.VarChar(255)
  displayName          String                @map("display_name") @db.VarChar(100)
  avatarUrl            String?               @map("avatar_url") @db.Text
  googleId             String?               @unique @map("google_id") @db.VarChar(255)
  isEmailVerified      Boolean               @default(false) @map("is_email_verified")
  lastLoginAt          DateTime?             @map("last_login_at") @db.Timestamptz
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  refreshTokens        RefreshToken[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("InvitedBy")
  createdBoards        Board[]               @relation("BoardCreator")
  starredBoards        UserStarredBoard[]
  createdCards         Card[]                @relation("CardCreator")
  assignedCards        CardAssignee[]
  cardComments         CardComment[]
  uploadedAttachments  CardAttachment[]
  activities           Activity[]
  createdDocuments     Document[]           @relation("DocumentCreator")
  documentSnapshots    DocumentSnapshot[]   @relation("SnapshotCreator")
  timeEntries          CardTimeEntry[]
  notifications        Notification[]

  @@index([googleId], map: "idx_users_google_id")
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  familyId   String    @map("family_id") @db.Uuid
  replacedBy String?   @map("replaced_by") @db.Uuid
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedToken    RefreshToken?  @relation("TokenRotation", fields: [replacedBy], references: [id])
  replacedByTokens RefreshToken[] @relation("TokenRotation")

  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

model Workspace {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?
  avatarUrl   String?   @map("avatar_url") @db.Text
  ownerId     String    @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  boards      Board[]
  labels      Label[]
  documents   Document[]
  fieldDefs   CardFieldDef[]
  notifications Notification[]

  @@index([ownerId], map: "idx_workspaces_owner")
  @@index([slug], map: "idx_workspaces_slug")
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "unique_workspace_member")
  @@index([workspaceId], map: "idx_wm_workspace")
  @@index([userId], map: "idx_wm_user")
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String           @db.VarChar(255)
  role        WorkspaceRole    @default(member)
  token       String           @unique @db.VarChar(255)
  invitedBy   String           @map("invited_by") @db.Uuid
  status      InvitationStatus @default(pending)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@index([email], map: "idx_invitations_email")
  @@map("workspace_invitations")
}

model Board {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  title           String    @db.VarChar(200)
  description     String?
  backgroundColor String?   @default("#1A1A2E") @map("background_color") @db.VarChar(7)
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator    User               @relation("BoardCreator", fields: [createdBy], references: [id])
  starredBy  UserStarredBoard[]
  lists      List[]
  activities Activity[]

  @@map("boards")
}

model UserStarredBoard {
  userId    String   @map("user_id") @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  starredAt DateTime @default(now()) @map("starred_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([userId, boardId])
  @@index([userId], map: "idx_starred_boards_user")
  @@map("user_starred_boards")
}

model Label {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String?  @db.VarChar(50)
  color       String   @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cardLabels CardLabel[]

  @@index([workspaceId], map: "idx_labels_workspace")
  @@map("labels")
}

model List {
  id         String    @id @default(uuid()) @db.Uuid
  boardId    String    @map("board_id") @db.Uuid
  title      String    @db.VarChar(200)
  rank       String    @db.VarChar(50)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@map("lists")
}

model Card {
  id              String       @id @default(uuid()) @db.Uuid
  listId          String       @map("list_id") @db.Uuid
  title           String       @db.VarChar(500)
  description     Json?        @db.JsonB
  rank            String       @db.VarChar(50)
  dueDate         DateTime?    @map("due_date") @db.Timestamptz
  isComplete      Boolean      @default(false) @map("is_complete")
  coverImageUrl   String?      @map("cover_image_url") @db.Text
  priority        CardPriority @default(medium)
  status          CardStatus   @default(not_started)
  parentCardId    String?      @map("parent_card_id") @db.Uuid
  estimateMinutes Int?         @map("estimate_minutes")
  loggedMinutes   Int          @default(0) @map("logged_minutes")
  createdBy       String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz

  list        List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator     User             @relation("CardCreator", fields: [createdBy], references: [id])
  parent      Card?            @relation("CardSubcards", fields: [parentCardId], references: [id], onDelete: SetNull)
  subcards    Card[]           @relation("CardSubcards")
  assignees   CardAssignee[]
  labels      CardLabel[]
  comments    CardComment[]
  attachments CardAttachment[]
  checklists  CardChecklist[]
  documents   Document[]
  fieldValues CardFieldValue[]
  timeEntries CardTimeEntry[]

  @@index([parentCardId], map: "idx_cards_parent")
  @@index([status], map: "idx_cards_status")
  @@index([priority], map: "idx_cards_priority")
  @@index([listId, status], map: "idx_cards_list_status")
  @@index([dueDate], map: "idx_cards_due_date")
  @@map("cards")
}

model CardAssignee {
  cardId     String   @map("card_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId], map: "idx_card_assignees_user")
  @@map("card_assignees")
}

model CardLabel {
  cardId  String @map("card_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("card_labels")
}

model CardComment {
  id               String    @id @default(uuid()) @db.Uuid
  cardId           String    @map("card_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  content          String    @db.Text
  parentCommentId  String?   @map("parent_comment_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  card            Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author          User @relation(fields: [authorId], references: [id])
  parent          CardComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         CardComment[] @relation("CommentReplies")

  @@index([parentCommentId], map: "idx_comments_parent")
  @@map("card_comments")
}

model CardAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  cardId       String         @map("card_id") @db.Uuid
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  type         AttachmentType @default(file)
  url          String         @db.Text
  name         String         @db.VarChar(255)
  mimeType     String?        @map("mime_type") @db.VarChar(100)
  fileSize     Int?           @map("file_size")
  coverUrl     String?        @map("cover_url") @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz

  card       Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([cardId], map: "idx_card_attachments_card")
  @@map("card_attachments")
}

model ActivityEvent {
  id          BigInt     @default(autoincrement())
  legacyId    String     @default(uuid()) @map("legacy_id") @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  boardId     String?    @map("board_id") @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id") @db.Uuid
  action      String     @db.VarChar(50)
  actorId     String     @map("actor_id") @db.Uuid
  payload     Json       @db.JsonB
  metadata    Json?      @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([id, createdAt])
  @@index([legacyId], map: "idx_activity_legacy")
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_activity_workspace")
  @@index([workspaceId, boardId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_activity_board")
  @@index([workspaceId, actorId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_activity_actor_workspace")
  @@index([entityType, entityId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_activity_entity")
  @@map("activity_events")
}

model Activity {
  id          String     @id @default(uuid()) @db.Uuid
  boardId     String?    @map("board_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  action      ActionType
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id") @db.Uuid
  entityTitle String?    @db.VarChar(500)
  fromListId  String?    @map("from_list_id") @db.Uuid
  toListId    String?    @map("to_list_id") @db.Uuid
  details     Json?      @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  board Board? @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId], map: "idx_activities_board")
  @@map("activities")
}

model CardChecklist {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  title     String   @db.VarChar(200)
  rank      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([cardId], map: "idx_checklists_card")
  @@map("card_checklists")
}

model ChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  checklistId String   @map("checklist_id") @db.Uuid
  content     String   @db.VarChar(500)
  isDone      Boolean  @default(false) @map("is_done")
  rank        String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  checklist CardChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId], map: "idx_checklist_items_checklist")
  @@map("checklist_items")
}

enum DocumentStatus {
  active
  archived

  @@map("document_status")
}

model Document {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  title        String         @default("Untitled") @db.VarChar(500)
  yjsState     Bytes?         @map("yjs_state")
  previewText  String?        @map("preview_text") @db.Text
  createdBy    String         @map("created_by") @db.Uuid
  parentCardId String?        @map("parent_card_id") @db.Uuid
  status       DocumentStatus @default(active)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator    User               @relation("DocumentCreator", fields: [createdBy], references: [id])
  parentCard Card?              @relation(fields: [parentCardId], references: [id], onDelete: SetNull)
  snapshots  DocumentSnapshot[]

  @@index([workspaceId], map: "idx_documents_workspace")
  @@index([workspaceId, status, updatedAt], map: "idx_documents_workspace_status_updated")
  @@index([parentCardId], map: "idx_documents_parent_card")
  @@map("documents")
}

model DocumentSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  yjsState     Bytes    @map("yjs_state")
  snapshotName String?  @map("snapshot_name") @db.VarChar(200)
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation("SnapshotCreator", fields: [createdBy], references: [id])

  @@index([documentId], map: "idx_snapshots_document")
  @@map("document_snapshots")
}

model CardFieldDef {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String        @db.VarChar(100)
  fieldType   CardFieldType @map("field_type")
  options     Json?         @db.JsonB
  required    Boolean       @default(false)
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CardFieldValue[]

  @@unique([workspaceId, name], map: "unique_field_def_name")
  @@index([workspaceId], map: "idx_field_defs_workspace")
  @@map("card_field_defs")
}

model CardFieldValue {
  id        String   @id @default(uuid()) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  field CardFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  card  Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([fieldId, cardId], map: "unique_field_value")
  @@index([cardId], map: "idx_field_values_card")
  @@map("card_field_values")
}

enum NotificationType {
  card_assigned
  comment_added
  comment_mentioned
  card_status_changed
  card_priority_changed
  card_linked
  workspace_invited
  workspace_role_changed

  @@map("notification_type")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  messageId   String           @map("message_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(300)
  body        String?          @db.Text
  entityType  EntityType?      @map("entity_type")
  entityId    String?          @map("entity_id") @db.Uuid
  boardId     String?          @map("board_id") @db.Uuid
  cardId      String?          @map("card_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, isRead, createdAt, id], map: "idx_notifications_user_unread")
  @@index([userId, createdAt, id], map: "idx_notifications_user_all")
  @@index([isRead, createdAt], map: "idx_notifications_read_cleanup")
  @@map("notifications")
}

model CardTimeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  minutes   Int
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([cardId], map: "idx_time_entries_card")
  @@map("card_time_entries")
}
