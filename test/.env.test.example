# SyncBoard E2E test environment (loaded by test/setup-env.ts)
# Matches the docker-compose.yml service layout (postgres/redis/mailhog/rabbitmq/minio).
NODE_ENV=test
PORT=3000

# Compose infrastructure
DATABASE_URL="postgresql://syncuser:syncpass@localhost:5432/syncboard?schema=public"
# Empty on purpose: the default compose stack has no read replica, so the
# activity feed must use the primary (root .env points at :5433 for --profile full).
DATABASE_REPLICA_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Files (MinIO): presigned URLs point at the local MinIO S3 API
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=syncboard-files
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=3600
MAX_FILE_SIZE_BYTES=26214400

# JWT: HS256 symmetric fallback (no RS256 key files in the test environment)
JWT_SECRET="e2e-test-secret-key-32-chars-minimum!!"

# Mail (MailHog): SMTP for outbound, HTTP API for assertions
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAILHOG_URL=http://localhost:8025
MAIL_FROM="SyncBoard E2E <no-reply@syncboard.local>"
MAIL_FROM_NAME=SyncBoard

# Misc
CLIENT_URL=http://localhost:3001
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
LOG_LEVEL=error
